{
  "format_version": "1.8.0",
  "animations": {
    "animation.parity.molang": {
      "loop": true,
      "animation_length": 2,
      "bones": {
        "head": { "rotation": ["math.sin(q.anim_time * 180) * 30", "math.cos(query.life_time * 90) * -20 + math.abs(-3)", "q.anim_time > 1 ? 15 : -15"] },
        "body": { "position": ["math.lerp(0, 4, q.anim_time / 2)", "math.clamp(q.anim_time * 10, 0, 7)", "math.mod(q.anim_time * 7, 3)"] },
        "rightArm": { "rotation": ["v.swing = math.sin(q.anim_time * 360) * 45; return v.swing * 2;", "math.pow(q.anim_time, 2) + math.sqrt(4)", "math.atan2(1, q.anim_time + 1) + math.hermite_blend(q.anim_time / 2)"] },
        "leftArm": { "rotation": ["math.lerprotate(10, 350, q.anim_time / 2)", "math.min_angle(q.anim_time * 400)", "math.floor(q.anim_time * 3.7) + math.ceil(-1.2) + math.round(2.5) + math.trunc(-2.7)"] },
        "rightLeg": { "rotation": ["math.exp(q.anim_time) - math.ln(q.anim_time + 1)", "(q.anim_time < 0.5 || q.anim_time >= 1.5) && !(q.is_on_ground == 0) ? 12 : 0", "math.random(10, 20) + math.die_roll(2, 1, 3) - math.random_integer(1, 2)"] },
        "leftLeg": {
          "rotation": { "0.0": [0, 0, 0], "0.5": { "pre": [10, 0, 0], "post": [20, 5, 0], "lerp_mode": "catmullrom" }, "1.0": ["-30 * math.sin(q.anim_time * 90)", 0, 0], "1.5": { "post": [5, 5, 5], "lerp_mode": "step" }, "2.0": [0, 0, 0] },
          "scale": { "0.0": 1, "1.0": [1.2], "2.0": 1 }
        },
        "Tail": { "rotation": [0, "q.modified_distance_moved * 10", 0], "position": "math.max(q.anim_time, 1.5)" }
      }
    },
    "animation.parity.timeupdate": {
      "animation_length": 1.5,
      "loop": "hold_on_last_frame",
      "anim_time_update": "q.anim_time + q.delta_time * 0.5",
      "bones": {
        "head": { "rotation": { "0": [0, 0, 0], "1.5": [0, 90, 0] } }
      }
    }
  }
}
